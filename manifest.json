{
  "manifest_version": 2,
  "name": "Snappy Pageload",
  "version": "1.0.0",
  "author": "Pavan Kumar Jadda",
  "developer": {
    "name": "Pavan Kumar Jadda",
    "url": "https://github.com/pavankjadda"
  },
  "description": "Preload same-origin links on hover and as they scroll into view, along with the scripts, stylesheets, fonts, and images their pages declare.",
  "homepage_url": "https://github.com/pavankjadda/Snappy-Pageload",

  "icons": {
    "48": "icons/rocket.svg",
    "96": "icons/rocket.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "background": {
    "scripts": ["js/shared.js", "js/background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "snappy-pageload@pavankjadda.github.io",
      "strict_min_version": "91.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "browser_action": {
    "default_icon": "icons/rocket.svg",
    "default_title": "Snappy Pageload"
  },

  "permissions": ["storage", "privacy", "http://*/*", "https://*/*"]
}
