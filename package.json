{
  "name": "snappy-pageload",
  "private": true,
  "version": "1.0.0",
  "description": "Preload visible same-site pages and their declared assets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pavankjadda/Snappy-Pageload.git"
  },
  "bugs": {
    "url": "https://github.com/pavankjadda/Snappy-Pageload/issues"
  },
  "homepage": "https://github.com/pavankjadda/Snappy-Pageload#readme",
  "type": "module",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "lint": "web-ext lint",
    "start": "web-ext run",
    "build": "web-ext build --overwrite-dest",
    "build:safari": "node scripts/build-safari.mjs",
    "build:safari:app": "node scripts/build-safari-app.mjs",
    "package:safari": "node scripts/package-safari.mjs",
    "package": "pnpm test && pnpm lint && pnpm build",
    "sign": "pnpm test && pnpm lint && node --env-file=.env.local node_modules/web-ext/bin/web-ext.js sign --channel=unlisted"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "web-ext": "^8.10.0"
  }
}
